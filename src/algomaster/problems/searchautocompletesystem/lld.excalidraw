    {
      "id": "6tt5-Ec9ED3ajpl7ZQlMd",
      "type": "text",
      "x": 660.9406610006363,
      "y": 8008.526037272288,
      "width": 648.3194580078125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1A",
      "roundness": null,
      "seed": 577352146,
      "version": 72,
      "versionNonce": 1050091346,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791104800007,
      "created": 1791091315452,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n\nSupport one-on-one and group messaging\nAllow users to view their complete chat history\nEnsure message ordering is preserved, i.e., messages must be deliv-\nered in the order they were sent",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n\nSupport one-on-one and group messaging\nAllow users to view their complete chat history\nEnsure message ordering is preserved, i.e., messages must be deliv-\nered in the order they were sent",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1Mdap60St8vedzlmZpDQl",
      "type": "text",
      "x": 665.9406610006363,
      "y": 8191.526037272288,
      "width": 800,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 1216555278,
      "version": 467,
      "versionNonce": 1902819022,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791104800007,
      "created": 1791091361104,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements:\n\nThread safety: Multiple users can send messages concurrently with minimal\nlatency and message ordering is preserved.\n\nExtensibility: System should be extensible to add new features such as deleting,\nmodifying message, message reactions, read receipts etc.\n\nModularity: OOPs, SOLID, etc.\n\nMaintainability: Easy to test, maintain, debug, etc.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements:\n\nThread safety: Multiple users can send messages concurrently with minimal latency and message ordering is preserved.\n\nExtensibility: System should be extensible to add new features such as deleting, modifying message, message reactions, read receipts etc.\n\nModularity: OOPs, SOLID, etc.\n\nMaintainability: Easy to test, maintain, debug, etc.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
