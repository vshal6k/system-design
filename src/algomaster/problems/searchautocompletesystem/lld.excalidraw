      "created": 1791105666645,
      "link": null,
      "locked": false,
      "text": "/words -> POST\n\n{\n    word: \"value\"\n}\n\nReturns \n\n{\n    word:\"value\"\n    count:\"count\"\n}\n\n\n/suggestions?q=prefix&strategy=strategy -> GET\n\n{\n    items:[\n                Word\n            ]\n\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/words -> POST\n\n{\n    word: \"value\"\n}\n\nReturns \n\n{\n    word:\"value\"\n    count:\"count\"\n}\n\n\n/suggestions?q=prefix&strategy=strategy -> GET\n\n{\n    items:[\n                Word\n            ]\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
