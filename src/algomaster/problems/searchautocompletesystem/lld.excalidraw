    {
      "id": "U6OK90ksbX81mJiA_oqcS",
      "type": "text",
      "x": 2423.5006650133996,
      "y": 8191.745214500748,
      "width": 800,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3B",
      "roundness": null,
      "seed": 529949390,
      "version": 566,
      "versionNonce": 1553333906,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791105267285,
      "created": 1791104978346,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements:\n\n-Scalability: System should be able to handle concurrent requests for\nsuggestions, word addition correctly and serve with low latency.\n-Extensibility: System should be easily extensible to include new features such as\nranking strategies.\n-Modularity: OOPS/SOLID principle.\n-Testability/Maintainability.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements:\n\n-Scalability: System should be able to handle concurrent requests for suggestions, word addition correctly and serve with low latency.\n-Extensibility: System should be easily extensible to include new features such as ranking strategies.\n-Modularity: OOPS/SOLID principle.\n-Testability/Maintainability.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
