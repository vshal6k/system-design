      "boundElements": [],
      "updated": 1791011101616,
      "created": 1790005525740,
      "link": null,
      "locked": false,
      "text": "Core Entities:\n\n1 - User \n2 - Card\n3 - Transaction\n4 - TransactionType\n5 - ATMState\n6 - IdleATMState\n7 - CardInsertedATMState\n8 - AuthenticatedATMState\n9 - Dispenser\n10 - BaseDispenser\n11 - HundredDispenser\n12 - FiftyDispenser\n13 - TwentyDispenser\n14 - TenDispenser\n15 - ATMMachine\n16 - BankService\n\nQuestions:\n1 - Do we list services, repositories also in core entities? yes.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities:\n\n1 - User \n2 - Card\n3 - Transaction\n4 - TransactionType\n5 - ATMState\n6 - IdleATMState\n7 - CardInsertedATMState\n8 - AuthenticatedATMState\n9 - Dispenser\n10 - BaseDispenser\n11 - HundredDispenser\n12 - FiftyDispenser\n13 - TwentyDispenser\n14 - TenDispenser\n15 - ATMMachine\n16 - BankService\n\nQuestions:\n1 - Do we list services, repositories also in core entities? yes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
